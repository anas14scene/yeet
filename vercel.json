    { "source": "/edibles", "destination": "/ecom/edibles/", "permanent": false },
    { "source": "/edibles/", "destination": "/ecom/edibles/", "permanent": false },
    { "source": "/cosmetics", "destination": "/ecom/cosmetics/", "permanent": false },
